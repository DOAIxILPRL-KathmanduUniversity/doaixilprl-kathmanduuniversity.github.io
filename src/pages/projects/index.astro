---
import Layout from '../../layouts/Layout.astro';
import { projects } from '../../data/projects';
---

<Layout
  title="Projects Directory | DoAI × ILPRL Kathmandu University"
  description="Comprehensive index of NLP internship and capstone projects conducted under DoAI and ILPRL at Kathmandu University."
  activeTab="projects"
>
  <div class="detail-header">
    <div class="container">
      <div class="breadcrumb">
        <a href="/">Home</a> <span>/</span> <span>Projects Index</span>
      </div>
      <h1 class="detail-title">NLP Internship Projects Directory</h1>
      <p class="detail-subtitle">
        A structured catalog indexing ongoing, completed, and upcoming NLP research projects conducted jointly between the Department of Artificial Intelligence (DoAI) and the Information and Language Processing Research Lab (ILPRL).
      </p>
    </div>
  </div>

  <main class="container" style="padding-top: 2rem; padding-bottom: 3.5rem;">
    <div class="project-list">
      {projects.map((proj) => (
        <article class="project-card" id={proj.slug}>
          <div class="project-top">
            <div>
              <h2 class="project-title">
                {proj.links?.find((l) => l.internal) ? (
                  <a href={proj.links.find((l) => l.internal)?.url}>
                    {proj.title}
                  </a>
                ) : (
                  proj.title
                )}
              </h2>
              <div class="project-subtitle">{proj.subtitle}</div>
            </div>
            <div class="project-badges">
              <span
                class={`badge ${
                  proj.status === 'Active'
                    ? 'badge-active'
                    : proj.status === 'In Progress'
                    ? 'badge-progress'
                    : 'badge-planned'
                }`}
              >
                {proj.status}
              </span>
              <span class="badge badge-category">{proj.category}</span>
            </div>
          </div>

          <div class="project-meta">
            {proj.candidate && (
              <span><strong>Candidate / Lead:</strong> {proj.candidate}</span>
            )}
            <span><strong>Timeline:</strong> {proj.timeline}</span>
            <span><strong>Mentorship:</strong> {proj.mentors.join('; ')}</span>
          </div>

          <p class="project-desc">{proj.abstract}</p>

          <div class="project-footer">
            <div class="project-badges">
              {proj.tags.map((t) => (
                <span class="badge" style="background: #f1f5f9; color: var(--color-text-muted);">
                  #{t}
                </span>
              ))}
            </div>

            <div class="project-links">
              {proj.links?.map((link) => (
                <a
                  href={link.url}
                  class={`btn ${link.internal ? 'btn-primary' : 'btn-secondary'}`}
                  target={link.internal ? undefined : '_blank'}
                  rel={link.internal ? undefined : 'noopener noreferrer'}
                >
                  {link.label} {link.internal ? '→' : '↗'}
                </a>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </main>
</Layout>
